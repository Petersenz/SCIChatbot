[Unit]
Description=SCI Chatbot API
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/sci-chatbot/current
EnvironmentFile=/home/ubuntu/apps/sci-chatbot/shared/app.env
ExecStart=/home/ubuntu/apps/sci-chatbot/runtime/venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/apps/sci-chatbot
MemoryMax=4G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
